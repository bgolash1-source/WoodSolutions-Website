{
  "mcpServers": {
    "Creem": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "--package",
        "creem",
        "--",
        "mcp",
        "start",
        "--api-key",
        "REPLACE_WITH_CREEM_TEST_KEY",
        "--server",
        "test",
        "--tool",
        "products-search",
        "--tool",
        "products-get",
        "--tool",
        "products-create",
        "--tool",
        "products-update",
        "--tool",
        "checkouts-create",
        "--tool",
        "checkouts-retrieve",
        "--tool",
        "customers-retrieve",
        "--tool",
        "customers-list",
        "--tool",
        "customers-get-orders",
        "--tool",
        "customers-list-licenses",
        "--tool",
        "subscriptions-get",
        "--tool",
        "subscriptions-search",
        "--tool",
        "transactions-get-by-id",
        "--tool",
        "transactions-search",
        "--tool",
        "discounts-create",
        "--tool",
        "discounts-get",
        "--tool",
        "discounts-search",
        "--tool",
        "licenses-validate",
        "--tool",
        "licenses-list-instances",
        "--tool",
        "stats-get-summary"
      ]
    }
  }
